{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "text-shimmer",
      "type": "registry:ui",
      "title": "Text Shimmer",
      "description": "Animated gradient sweep across text.",
      "categories": ["text", "animation"],
      "registryDependencies": ["@kiln/utils", "@kiln/use-prefers-reduced-motion"],
      "files": [
        {
          "path": "text-shimmer/text-shimmer.tsx",
          "type": "registry:ui",
          "target": "@ui/kiln/text-shimmer.tsx"
        }
      ],
      "cssVars": {
        "theme": {
          "--kiln-shimmer-duration": "2s"
        }
      },
      "css": {
        "@keyframes kiln-shimmer": {
          "from": {
            "background-position": "100% center"
          },
          "to": {
            "background-position": "0% center"
          }
        },
        "@utility kiln-text-shimmer": {
          "display": "inline-block",
          "background-clip": "text",
          "-webkit-background-clip": "text",
          "color": "transparent",
          "-webkit-text-fill-color": "transparent",
          "background-repeat": "no-repeat",
          "background-size": "250% 100%",
          "background-image": "linear-gradient(90deg, color-mix(in oklch, currentColor 35%, transparent) 0%, color-mix(in oklch, currentColor 35%, transparent) calc(50% - var(--kiln-shimmer-spread, 40px)), currentColor 50%, color-mix(in oklch, currentColor 35%, transparent) calc(50% + var(--kiln-shimmer-spread, 40px)), color-mix(in oklch, currentColor 35%, transparent) 100%)",
          "animation": "kiln-shimmer var(--kiln-shimmer-duration, 2s) linear infinite"
        }
      }
    }
  ]
}
